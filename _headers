# Security & CSP Headers (all routes)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://challenges.cloudflare.com https://*.cloudflareinsights.com https://*.googlesyndication.com https://*.adservice.google.com https://*.google.com https://*.doubleclick.net https://*.clarity.ms https://www.clarity.ms https://*.adtrafficquality.google; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.cloudflareinsights.com https://cloudflareinsights.com https://challenges.cloudflare.com https://*.googlesyndication.com https://*.adservice.google.com https://*.google.com https://*.doubleclick.net https://*.clarity.ms https://*.adtrafficquality.google; img-src * data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.google.com https://*.googlesyndication.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://challenges.cloudflare.com https://*.doubleclick.net https://*.google.com https://*.googlesyndication.com https://*.adtrafficquality.google; frame-ancestors 'self' https://*.google.com https://*.googlesyndication.com; media-src * data: blob:;

# Caching: assets cached a day (with background revalidation),
# HTML always revalidated so deploys reach returning visitors.
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Markdown alternates (generated by scripts/markdown.mjs) are for agents,
# not search results — Google keeps indexing the HTML originals
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# Machine-readable entry points, advertised from the homepage (RFC 8288)
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </llms-full.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml", </index.md>; rel="alternate"; type="text/markdown"
